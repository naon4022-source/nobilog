{
  "name": "nobilog-board",
  "main": "src/index.js",
  "workers_dev": true,
  "preview_urls": true,
  "compatibility_date": "2026-07-01",
  "triggers": {
    "crons": [
      "0 22 * * *",
      "0 3 * * *",
      "0 9 * * *"
    ]
  },
  "vars": {
    "APP_ORIGIN": "https://nobilog.pages.dev",
    "LIFE_ORIGIN": "https://nobilog-life.pages.dev"
  },
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_id": "d3345327-f92c-4c72-b35c-671e84365e6a"
    }
  ],
  "kv_namespaces": [
    {
      "id": "96935bc8d01143babde9a71bafa86d6b",
      "binding": "BOARD"
    }
  ]
}