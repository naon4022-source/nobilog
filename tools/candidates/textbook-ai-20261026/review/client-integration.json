          "start": 204310,
          "end": 204310,
          "before": "",
          "after": "    function testReviewNotice(job){return {id:'test-review:'+job.id,testReviewId:job.id,category:'exam',title:'テストの解答とコメントができました',body:'ノビーと解説を確認して、次の一問につなげよう。',at:job.completedAt};}\n    function testReviewReady(who){return !!currentUserId&&serverBootReady&&!authLeaseBlocked&&!isTrial()&&(!who||cloudSame(who));}\n    async function testReviewRequest(path,options,who){\n        if(!testReviewReady(who))throw Object.assign(Error('session_changed'),{code:'session_changed'});\n        const result=await textbookAIRequest(path,options,who);\n        if(!testReviewReady(who))throw Object.assign(Error('session_changed'),{code:'session_changed'});\n        return result;\n    }\n    window.nobiTestReviewAPI={\n        available:()=>testReviewReady(),snapshot:()=>cloudIdentity(),matches:who=>testReviewReady(who),\n        list:who=>testReviewRequest('/material-test-review',{},who),\n        get:(id,who)=>testReviewRequest('/material-test-review?id='+encodeURIComponent(id),{},who),\n        post:(body,who)=>testReviewRequest('/material-test-review',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)},who),\n        status:(id,who)=>testReviewRequest('/material-test-session?id='+encodeURIComponent(id),{},who),\n        plan:who=>testReviewRequest('/plan',{},who),\n        canNotify:()=>testReviewReady()&&noticeAllowed(testReviewNotice({id:'',completedAt:0})),\n        notify:(job,who)=>{if(!testReviewReady(who)||document.hidden)return false;const before=noticeToastSerial;noticeToast(testReviewNotice(job));return noticeToastSerial>before;}\n    };\n"
        },
